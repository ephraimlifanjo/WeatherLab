# Local Docker defaults are used when these are blank.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/weatherlab
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=weatherlab
# For managed Cassandra, also set these as needed:
# CASSANDRA_USERNAME=
# CASSANDRA_PASSWORD=
# CASSANDRA_SECURE_BUNDLE_BASE64=
