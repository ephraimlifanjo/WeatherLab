{
  "name": "weatherlab",
  "version": "1.0.0",
  "private": true,
  "description": "WeatherLab — live weather and a MongoDB + Cassandra NoSQL learning lab",
  "main": "server.js",
  "engines": {"node": ">=20"},
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f"
  },
  "dependencies": {
    "cassandra-driver": "^4.8.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.12.0"
  }
}